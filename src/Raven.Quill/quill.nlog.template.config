<?xml version="1.0" encoding="utf-8" ?>
<!--
  A copy of the logging configuration the appliance runs on, for operators to edit.

  This file is NOT loaded. The appliance builds the same configuration in code at startup, the way
  RavenDB does when Logs.ConfigPath is unset, and this is the annotated copy to crib from - the
  counterpart of RavenDB's own NLog.template.config.

  To take it over, put your edited copy on the volume as /var/lib/quill/quill.nlog.config. That copy
  is loaded in preference to the built-in defaults, survives `docker compose down && up`, and is what
  POST /api/settings/logs/configuration writes into. Persisting a change also creates it for you, from
  whatever was running at the time, so you never have to copy this file by hand to get started.
  RAVEN_QUILL_LOGS_CONFIG_PATH overrides that location; setting it empty means changes stay in memory
  and nothing is written.

  Rule names are load-bearing: Raven_Default, Raven_Default_Audit, Raven_System and Raven_Microsoft are
  looked up by name, and so are the QuillLogging, QuillLoggingAudit, AsyncTargetWrapper and Console
  targets - rename AsyncTargetWrapper and the API can no longer switch the file sink on. Nothing here can
  stop the appliance starting, though - if a rule is missing, or the file will not parse, it falls back to
  the built-in defaults and says so at startup. grep for "built-in defaults".

  Only ${environment:...} inside a layout - a fileName - or a rule's level attribute is resolved. NLog
  cannot convert it for numeric attributes such as archiveAboveSize: it leaves -1, which means no
  rotation at all. Set those here as literals. throwConfigExceptions stays false so a typo degrades one
  setting rather than the file, and anything NLog could not apply is warned about at startup instead -
  grep for "could not be applied".

  Do not add ${rvn:NodeTag}: that renderer is registered only in Raven.Server and will not resolve here.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="false">

  <variable name="logPath" value="${environment:RAVEN_QUILL_LOGS_PATH:whenEmpty=${basedir}/logs}" />
  <variable name="auditLogPath" value="${environment:RAVEN_QUILL_SECURITY_AUDITLOG_PATH:whenEmpty=${basedir}/logs}" />

  <!--
    One layout for both files, as RavenDB's template has. Audit records are one line each, and what keeps
    them that way is the code that writes them: every request-derived value is folded through
    QuillAudit.Safe at the point it is interpolated, so nothing here has to defend the format.
  -->
  <variable name="quillLayout"
            value="${longdate:universalTime=true}|${level:uppercase=true}|${threadid}|${event-properties:item=Resource}|${event-properties:item=Component}|${logger}|${message:withexception=true}|${event-properties:item=Data}" />

  <targets>
    <target xsi:type="AsyncWrapper" name="AsyncTargetWrapper">
      <target name="QuillLogging"
              xsi:type="File"
              createDirs="true"
              fileName="${var:logPath}/quill.log"
              archiveNumbering="DateAndSequence"
              header="Date|Level|ThreadID|Resource|Component|Logger|Message|Data"
              layout="${var:quillLayout}"
              footer="Date|Level|ThreadID|Resource|Component|Logger|Message|Data"
              concurrentWrites="false"
              writeFooterOnArchivingOnly="true"
              archiveAboveSize="134217728"
              archiveOldFileOnStartup="true"
              archiveOldFileOnStartupAboveSize="134217728"
              maxArchiveDays="3"
              enableArchiveFileCompression="false" />
    </target>

    <target name="QuillLoggingAudit"
            xsi:type="File"
            createDirs="true"
            fileName="${var:auditLogPath}/quill.audit.log"
            archiveNumbering="DateAndSequence"
            header="Date|Level|ThreadID|Resource|Component|Logger|Message|Data"
            layout="${var:quillLayout}"
            footer="Date|Level|ThreadID|Resource|Component|Logger|Message|Data"
            concurrentWrites="false"
            writeFooterOnArchivingOnly="true"
            autoFlush="true"
            archiveAboveSize="134217728"
            archiveOldFileOnStartup="true"
            archiveOldFileOnStartupAboveSize="134217728"
            maxArchiveDays="3"
            enableArchiveFileCompression="false" />

    <target name="Console" xsi:type="Console" layout="${var:quillLayout}" />

    <target name="Raven_Polly" xsi:type="Null" />
  </targets>

  <rules>
    <!-- Polly's retry chatter is dropped before it reaches any other rule -->
    <logger ruleName="Raven_Polly" name="Polly*" minlevel="Trace" writeTo="Raven_Polly" final="true" />

    <!--
      Microsoft and System logging is not captured at all, the way RavenDB ships Logs.Microsoft.Enabled
      false - enabling it is known to cost request latency, so it is never bought by accident. The API
      refuses a microsoftLogs block with 400 while it is off: switching it on is an edit here plus a
      restart, deliberately.

      finalMinLevel blocks everything BELOW the level named, so it sits one step under the level you
      actually want, and both ends are sentinels: Fatal is what the API calls Off, Warn here means
      "Error and above", and NLog's own Off would mean the opposite - log everything. That offset is why
      this is a literal and not an environment variable. Change it here, or through the API once it is
      on, which converts for you.
    -->
    <logger ruleName="Raven_System" name="System.*" finalMinLevel="Fatal" />
    <logger ruleName="Raven_Microsoft" name="Microsoft.*" finalMinLevel="Fatal" />

    <!--
      The audit log is off until you switch it on: add writeTo="QuillLoggingAudit" to the rule below,
      the same way RavenDB's own template leaves it. Until then every audit call is a no-op and
      GET /api/settings/logs/configuration reports auditLogs.level as Off. Nothing warns about it at
      startup - check the endpoint if you need to know.
    -->
    <logger ruleName="Raven_Default_Audit" name="Audit" levels="Info" final="true" />

    <!--
      Stdout is the appliance's primary log and s6 already rotates it, so the file sink is off by
      default: add AsyncTargetWrapper to writeTo below to also write quill.log, and point
      RAVEN_QUILL_LOGS_PATH at a directory on the volume so it survives a recreate. The API can do
      both for you - POST a logs.path and it wires the sink up and writes there from the next line on.
      Nothing is moved: whatever was written before, and its archives, stay in the old directory. Copy
      them across yourself if you want the history, before a recreate takes the old directory with it.
    -->
    <logger ruleName="Raven_Default" name="*" minlevel="Info" writeTo="Console" />
  </rules>
</nlog>
