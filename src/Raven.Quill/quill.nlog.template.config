<?xml version="1.0" encoding="utf-8" ?>
<!--
  A copy of the logging configuration the appliance runs on, for operators to edit - the counterpart of
  RavenDB's own NLog.template.config.

  This file is NOT loaded. Put your edited copy on the volume as /var/lib/quill/quill.nlog.config, which
  is picked up from there without any variable being set; RAVEN_QUILL_LOGS_CONFIG_PATH names a different
  location. A copy wins over RAVEN_QUILL_LOGS_MINLEVEL and RAVEN_QUILL_LOGS_PATH, and can read them
  itself with ${environment:...} if you want both. docker/quill/README.md has the rest.

  Raven_Default and Raven_Default_Audit are looked up by name: a copy that has lost either one stops the
  appliance starting, the same assertion RavenDB makes about its own NLog.config.

  ${environment:...} resolves inside a layout - a fileName - or a rule's level attribute, and nowhere
  else. NLog cannot convert it for a numeric attribute such as archiveAboveSize, where it leaves -1 and
  so no rotation at all; set those as literals. Do not add ${rvn:NodeTag} either - that renderer is
  registered only in Raven.Server and will not resolve here.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="false">

  <variable name="logPath" value="${environment:RAVEN_QUILL_LOGS_PATH:whenEmpty=${basedir}/logs}" />
  <variable name="auditLogPath" value="${environment:RAVEN_QUILL_SECURITY_AUDITLOG_PATH:whenEmpty=${basedir}/logs}" />
  <variable name="quillLayout"
            value="${longdate:universalTime=true}|${level:uppercase=true}|${threadid}|${event-properties:item=Resource}|${event-properties:item=Component}|${logger}|${message:withexception=true}|${event-properties:item=Data}" />

  <targets>
    <target xsi:type="AsyncWrapper" name="AsyncTargetWrapper">
      <target
        name="QuillLogging"
        xsi:type="File"
        createDirs="true"
        fileName="${var:logPath}/quill.log"
        archiveNumbering="DateAndSequence"
        header="Date|Level|ThreadID|Resource|Component|Logger|Message|Data"
        layout="${var:quillLayout}"
        footer="Date|Level|ThreadID|Resource|Component|Logger|Message|Data"
        concurrentWrites="false"
        writeFooterOnArchivingOnly="true"
        archiveAboveSize="134217728"
        archiveOldFileOnStartup="true"
        archiveOldFileOnStartupAboveSize="134217728"
        maxArchiveDays="3"
        enableArchiveFileCompression="false" />
    </target>

    <target xsi:type="AsyncWrapper" name="AuditAsyncTargetWrapper">
      <target
        name="QuillLoggingAudit"
        xsi:type="File"
        createDirs="true"
        fileName="${var:auditLogPath}/quill.audit.log"
        archiveNumbering="DateAndSequence"
        header="Date|Level|ThreadID|Resource|Component|Logger|Message|Data"
        layout="${var:quillLayout}"
        footer="Date|Level|ThreadID|Resource|Component|Logger|Message|Data"
        concurrentWrites="false"
        writeFooterOnArchivingOnly="true"
        archiveAboveSize="134217728"
        archiveOldFileOnStartup="true"
        archiveOldFileOnStartupAboveSize="134217728"
        maxArchiveDays="3"
        enableArchiveFileCompression="false" />
    </target>

    <!-- stdout is the appliance's primary log: s6 rotates that stream, so the file above is opt-in -->
    <target name="Console" xsi:type="Console" layout="${var:quillLayout}" />

    <target name="Raven_Polly" xsi:type="Null" />
  </targets>

  <rules>
    <!-- Polly's retry chatter is dropped before it reaches any other rule -->
    <logger ruleName="Raven_Polly" name="Polly*" minlevel="Trace" writeTo="Raven_Polly" final="true" />

    <!-- In order to enable audit log writing to disk add writeTo="AuditAsyncTargetWrapper" below -->
    <logger ruleName="Raven_Default_Audit" name="Audit" levels="Info" final="true" />

    <!-- In order to also write quill.log add AsyncTargetWrapper to the writeTo below -->
    <logger ruleName="Raven_Default" name="*" minlevel="Info" writeTo="Console" />
  </rules>
</nlog>
