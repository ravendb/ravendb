<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Raven.Quill</AssemblyName>
    <PackageId>Raven.Quill</PackageId>
    <CodeAnalysisRuleSet>..\..\RavenDB.ruleset</CodeAnalysisRuleSet>
    <UserSecretsId>raven-quill-26627</UserSecretsId>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>obj\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name quill</OpenApiGenerateDocumentsOptions>
    <AssemblyTitle>Raven.Quill</AssemblyTitle>
    <RootNamespace>Raven.Quill</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Compile Include="..\CommonAssemblyInfo.Windows.cs" Link="Properties\CommonAssemblyInfo.Windows.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Include="..\CommonAssemblyInfo.Linux.cs" Link="Properties\CommonAssemblyInfo.Linux.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Raven.Client\Raven.Client.csproj" />
    <ProjectReference Include="..\Sparrow\Sparrow.csproj" />
    <Compile Include="..\..\src\Raven.Server\Commercial\ApiHttpClient.cs" Link="Raven\Linked\ApiHttpClient.cs" />
    <Compile Include="..\..\src\Raven.Server\Utils\RavenHttpClient.cs" Link="Raven\Linked\RavenHttpClient.cs" />
    <Compile Include="..\..\src\Raven.Server\ServerWide\ServerVersion.cs" Link="Raven\Linked\ServerVersion.cs" />
    <Compile Include="..\..\src\Raven.Server\Smuggler\Documents\Processors\BuildVersion.cs" Link="Raven\Linked\BuildVersion.cs" />
    <Compile Include="..\Sparrow.Server\AsyncManualResetEvent.cs" Link="Hosting\Linked\AsyncManualResetEvent.cs" />
    <Compile Include="..\..\src\Raven.Server\Logging\RavenAuditLogger.cs" Link="Raven\Linked\RavenAuditLogger.cs" />
    <Compile Include="..\..\src\Sparrow.Server\Logging\LogLevelExtensions.cs" Link="Raven\Linked\LogLevelExtensions.cs" />
    <Compile Include="..\..\src\Sparrow.Server\Logging\RavenLogger.cs" Link="Raven\Linked\RavenLogger.cs" />
    <Compile Include="..\..\src\Sparrow.Server\Logging\RavenNLogLogManager.cs" Link="Raven\Linked\RavenNLogLogManager.cs" />
    <Compile Include="..\..\src\Sparrow.Server\Logging\RavenNLogLoggingConfigurationChangedEventArgs.cs" Link="Raven\Linked\RavenNLogLoggingConfigurationChangedEventArgs.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="quill.nlog.template.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Resilience" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Telegram.Bot" />
    <PackageReference Include="NLog" />
    <PackageReference Include="JetBrains.Annotations" />
  </ItemGroup>

</Project>
