{
    "name": "@raven-quill/widget",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build && node ./scripts/check-bundle.mjs",
        "typecheck": "tsc -b",
        "check:bundle": "node ./scripts/check-bundle.mjs",
        "test:unit": "vitest run --project=unit",
        "test:storybook": "vitest run --project=storybook",
        "storybook": "storybook dev -p 6007 --no-open",
        "build-storybook": "storybook build"
    },
    "//": "Exact pins on purpose: this bundle ships to third-party websites, so a dependency bump here must be a deliberate, separately reviewed change (see scripts/check-bundle.mjs for the size guard).",
    "dependencies": {
        "preact": "10.29.8",
        "react-markdown": "10.1.0",
        "rehype-sanitize": "6.0.0",
        "remark-gfm": "4.0.1",
        "remend": "1.3.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.0",
        "@types/hast": "3.0.5",
        "@types/node": "24.12.4",
        "tailwindcss": "4.3.0",
        "typescript": "6.0.3",
        "vite": "8.1.5",
        "vitest": "4.1.10"
    }
}
