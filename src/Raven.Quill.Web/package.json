{
    "name": "raven-quill-web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@11.2.2",
    "scripts": {
        "dev": "pnpm generate:api && vite",
        "build": "pnpm generate:api && tsc -b && vite build && pnpm build:widget",
        "build:widget": "pnpm --filter @raven-quill/widget build && node ./scripts/copy-widget-dist.mjs",
        "generate:api": "node ./scripts/generate-api.mjs",
        "typecheck": "tsc -b && pnpm --filter @raven-quill/widget typecheck",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier . --check",
        "format:fix": "prettier . --write",
        "preview": "vite preview",
        "storybook": "pnpm build:widget && storybook dev -p 6006",
        "build-storybook": "pnpm build:widget && storybook build",
        "test:storybook": "pnpm build:widget && vitest run --project=storybook && pnpm --filter @raven-quill/widget test:storybook",
        "test:unit": "vitest run --project=unit && pnpm --filter @raven-quill/widget test:unit"
    },
    "dependencies": {
        "@base-ui/react": "^1.5.0",
        "@fontsource-variable/geist": "^5.2.9",
        "@fontsource-variable/geist-mono": "^5.2.8",
        "@hookform/resolvers": "^5.2.2",
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "^9.7.0",
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/react-query": "^5.100.10",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.13.26",
        "ace-builds": "^1.44.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.16.0",
        "next-themes": "^0.4.6",
        "postcss": "^8.5.26",
        "radix-ui": "^1.4.3",
        "react": "^19.2.6",
        "react-ace": "^14.0.1",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.6",
        "react-hook-form": "^7.76.0",
        "react-resizable-panels": "^4.11.2",
        "react-router": "^7.15.1",
        "recharts": "^3.9.0",
        "shadcn": "^4.7.0",
        "sonner": "^2.0.7",
        "streamdown": "^2.5.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.0",
        "three": "^0.185.1",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@storybook/addon-vitest": "^10.4.4",
        "@storybook/react-vite": "^10.4.4",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.12.4",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/three": "^0.185.4",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/browser-playwright": "^4.1.10",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.7.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "eslint-plugin-storybook": "^10.4.4",
        "globals": "^17.6.0",
        "msw": "^2.14.6",
        "msw-storybook-addon": "^2.0.7",
        "openapi-msw": "^2.0.0",
        "openapi-typescript": "^7.13.0",
        "playwright": "^1.61.1",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "storybook": "^10.4.4",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.59.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "msw": {
        "workerDirectory": [
            ".storybook/public"
        ]
    }
}
