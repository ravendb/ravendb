<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Raven.Analyzers.CodeFixes</AssemblyName>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Activate RS1038 (and the rest of the extended analyzer ruleset) here too, so that if a
         DiagnosticAnalyzer is ever added to this project the compiler-only-reference rule is
         enforced rather than silently dormant — matching the sibling Raven.Analyzers project. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <LangVersion>preview</LangVersion>
    <!-- Must match Raven.Analyzers; see the note on its PackageReference. -->
    <RavenAnalyzerRoslynVersion>4.4.0</RavenAnalyzerRoslynVersion>
    <!--
      Transitive pinning is repo-wide, but must not apply here. It would drag this assembly's
      System.Collections.Immutable and System.Reflection.Metadata up to the repo's versions, which are
      newer than the ones the host compiler ships, and the analyzer then fails to load with CS8032.
      Roslyn's own constraints are the correct ones for an assembly the compiler loads.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      This assembly is intentionally split off from Raven.Analyzers. Per RS1038
      (https://github.com/dotnet/roslyn-analyzers/issues/7438) analyzer assemblies must
      only reference compiler-provided assemblies; Microsoft.CodeAnalysis.CSharp.Workspaces
      (required by code-fix providers) is not one of them. Both DLLs are embedded together
      into analyzers/dotnet/cs/ inside the RavenDB.Client NuGet package: IDEs load both,
      command-line builds load only the analyzer DLL.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Declared explicitly rather than taken transitively from Workspaces: this project uses
         Microsoft.CodeAnalysis.CSharp types (SyntaxNode, the CSharp.Syntax nodes) directly. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(RavenAnalyzerRoslynVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="$(RavenAnalyzerRoslynVersion)" PrivateAssets="all" />
    <ProjectReference Include="..\Raven.Analyzers\Raven.Analyzers.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
