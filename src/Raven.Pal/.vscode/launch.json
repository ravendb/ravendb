{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug test-linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/test-linux",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build-test-linux",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug test-win",
            "type": "cppvsdbg",  // For MSVC build
            "request": "launch",
            "program": "${workspaceFolder}/test-win.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "build-test-win-msvc",
        }
    ]
}