<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Raven.Analyzers</AssemblyName>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IsPackable>false</IsPackable>
    <LangVersion>preview</LangVersion>
    <!-- Shared with Raven.Analyzers.CodeFixes; both DLLs must bind the same Roslyn. -->
    <RavenAnalyzerRoslynVersion>4.4.0</RavenAnalyzerRoslynVersion>
    <!--
      Transitive pinning is repo-wide, but must not apply here. It would drag this assembly's
      System.Collections.Immutable and System.Reflection.Metadata up to the repo's versions, which are
      newer than the ones the host compiler ships, and the analyzer then fails to load with CS8032.
      Roslyn's own constraints are the correct ones for an assembly the compiler loads.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <Nullable>enable</Nullable>
    <!--
      This project is not packaged on its own. Raven.Analyzers.dll and
      Raven.Analyzers.CodeFixes.dll are embedded inside RavenDB.Client.nupkg
      under analyzers/dotnet/cs/. See src/Raven.Client/Raven.Client.csproj.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned WELL BELOW the repo-wide version, and deliberately not kept in step with it.

      An analyzer is forward compatible but not backward: the compiler refuses to load one built
      against a Roslyn newer than itself, reports CS9057, and with TreatWarningsAsErrors that is a
      build failure in the consumer's project. Since these DLLs ship inside RavenDB.Client, the
      version chosen here is the oldest SDK a consumer can build with. Compiling against the repo's
      own Roslyn would break every consumer whose SDK is older than ours.

      Raise it only with a reason, knowing it drops the SDKs below the new value.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(RavenAnalyzerRoslynVersion)" PrivateAssets="all" />
    <!--
      Microsoft.CodeAnalysis.CSharp.Workspaces is intentionally NOT referenced here.
      Per RS1038 (https://github.com/dotnet/roslyn-analyzers/issues/7438) analyzer
      assemblies must only depend on compiler-provided references. Code-fix providers
      that need Workspaces live in the sibling Raven.Analyzers.CodeFixes project.
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- Enables RS2008 release tracking: every rule ID must appear in Shipped or Unshipped. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!--
    Bakes the product version into the analyzer assembly so SeverityPolicy can compute each
    diagnostic's effective severity (Info in the introducing release, destination severity after).
    The version is read from the single source of truth, src/CommonAssemblyInfo.cs, the same
    AssemblyVersion line that scripts/version.ps1 parses during a release build. A plain
    'dotnet build' reads the committed value, so the behaviour is deterministic locally too.
  -->
  <Target Name="GenerateRavenProductVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_RavenCommonAssemblyInfo>$(MSBuildProjectDirectory)\..\CommonAssemblyInfo.cs</_RavenCommonAssemblyInfo>
      <!--
        Extract via Match, not Replace: Regex.Replace returns the WHOLE input unchanged when the
        pattern does not match, which would bake the entire file (embedded quotes and newlines) into
        the generated const and fail to compile. Match captures only the version; if the
        AssemblyVersion line is ever renamed or removed the captured group is empty and the Error
        below fails the build with a clear message instead of emitting broken source.
      -->
      <RavenProductVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_RavenCommonAssemblyInfo)')), 'AssemblyVersion\("([^"]*)"\)').Groups.get_Item(1).Value)</RavenProductVersion>
      <_RavenProductVersionFile>$(IntermediateOutputPath)RavenProductVersion.g.cs</_RavenProductVersionFile>
    </PropertyGroup>
    <Error Condition="'$(RavenProductVersion)' == ''"
           Text="GenerateRavenProductVersion: could not read AssemblyVersion from $(_RavenCommonAssemblyInfo). SeverityPolicy.ProductVersion depends on it." />
    <WriteLinesToFile
        File="$(_RavenProductVersionFile)"
        Lines="namespace Raven.Analyzers.Shared { public static partial class SeverityPolicy { internal const string ProductVersion = &quot;$(RavenProductVersion)&quot;%3B } }"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_RavenProductVersionFile)" />
      <FileWrites Include="$(_RavenProductVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
