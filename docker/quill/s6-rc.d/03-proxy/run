#!/command/with-contenv sh
set -e

# nginx :443 SNI front (Phase 1). It terminates TLS for the web subdomains with the wildcard cert
# 01-ravendb/run places on the volume, which only exists post-activation. Wait for it; pre-activation
# the operator reaches the dashboard on the published :5000 (first-run). db.*/a.* are TLS-passthrough.

CERT_DIR=/var/lib/quill/certs
PROXY_DIR=/var/lib/quill/proxy
mkdir -p "$PROXY_DIR"

i=0
while [ -z "$(ls "$CERT_DIR"/cluster.server.certificate.*.pfx 2>/dev/null)" ]; do
    i=$((i + 1))
    if [ "$i" -ge 600 ]; then
        echo "03-proxy: wildcard cert not present at $CERT_DIR after 600s; aborting." >&2
        exit 1
    fi
    sleep 1
done

proxy-certs

# Render the RavenDB passthrough port into the config from RAVEN_QUILL_RAVENDB_INTERNAL_PORT — the same env
# 01-ravendb/run binds RavenDB to — so the two never drift. Run the rendered copy.
RAVENDB_PORT="${RAVEN_QUILL_RAVENDB_INTERNAL_PORT:-8443}"
sed "s|__RAVENDB_PORT__|${RAVENDB_PORT}|g" /etc/nginx/nginx.conf > "$PROXY_DIR/nginx.conf"

exec nginx -c "$PROXY_DIR/nginx.conf" -g 'daemon off;'
